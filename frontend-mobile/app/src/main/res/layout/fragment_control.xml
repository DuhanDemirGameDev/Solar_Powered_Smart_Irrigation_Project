<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/irrigation_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="28dp"
        android:paddingEnd="22dp"
        android:paddingBottom="34dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pump Control"
            android:textColor="@color/irrigation_text"
            android:textSize="31sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Manual override for fast irrigation response"
            android:textColor="@color/irrigation_muted"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            app:cardBackgroundColor="@color/irrigation_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:contentPadding="18dp"
            app:strokeColor="@color/irrigation_hairline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_start_pump"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="START PUMP (15s)"
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/irrigation_green"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_play_water"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_stop_pump"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:layout_marginTop="18dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="STOP PUMP"
                    android:textColor="@color/irrigation_danger"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/irrigation_danger_soft"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_stop"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="@color/irrigation_danger"
                    app:strokeColor="@color/irrigation_danger"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Commands are queued instantly through the local backend"
            android:textColor="@color/irrigation_muted"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
